# ==============================================================================
# Multi-Provider AI Fallback Engine Environment Variables
# ==============================================================================

# Tier 1: Google AI Studio
# Free tier key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Tier 2: GroqCloud (Ultra-fast LPUs)
# Free tier key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Tier 3: Cerebras Cloud (Wafer-scale speed)
# Free tier key: https://cloud.cerebras.ai
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Tier 4: OpenRouter (Universal Gateway & Free Community Pool)
# Free tier key: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Tier 5: Mistral AI (European Frontier AI)
# Free tier key: https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_api_key_here

# Tier 6: Cloudflare Workers AI (Serverless Edge)
# Dashboard: https://dash.cloudflare.com
CLOUDFLARE_API_KEY=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
